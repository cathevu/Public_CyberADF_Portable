              <Margins>0,0,0,0</Margins>
              <Name>Text73</Name>
              <Page isRef="201" />
              <Parent isRef="204" />
              <Text>(*) Ngày bắt đầu bảo hành là ngày Đại lý xuất hóa đơn giá trị gia tăng hợp lệ cho Khách hàng.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
