              <Margins>0,0,0,0</Margins>
              <Name>Text40</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Bảo hiểm vật chất xe (thời gian:……..….)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text40>
            <Text41 Ref="51" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0.4,7.3,3.5,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8</Font>
              <Guid>fb4eae6c486d4852ba9eb609e63a2df7</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text41</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Bảo dưỡng định kỳ trọng gói SSP (thời gian:……….)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text41>
            <Text42 Ref="52" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0,7.5,3.9,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8,Bold</Font>
              <Guid>df85ac5d5444486a913d423f59c402ae</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text42</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>2. Dành cho xe điện (nếu có)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text42>
            <Text43 Ref="53" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0.4,7.7,3.5,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8</Font>
              <Guid>6f428e9015654cd0b1ffbf6b2ad18b54</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text43</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Thiết bị sạc:Bao gồm Sạc di động và Sạc WallBox</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text43>
            <Text44 Ref="54" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0.4,7.9,3.5,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8</Font>
              <Guid>c830214031ba425b88dab71286c73d20</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text44</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Sạc tại nhà và Sạc công cộng: Các hướng dẫn và giải pháp sạc</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text44>
            <Text45 Ref="55" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0.4,8.1,3.5,0.3</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8</Font>
              <Guid>70e2096e4f874ad8995e7618bc1c4769</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text45</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Chăm sóc pin: Các hướng dẫn và giải pháp việc chăm sóc và bảo trì pin</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text45>
            <Text46 Ref="56" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>4,1.9,3.5,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8,Bold</Font>
              <Guid>a255644c30c6449e80af2bd765d1b74f</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text46</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>III. Giấy tờ giao nhận xe</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text46>
            <Text48 Ref="57" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>4.2,2.2,3.3,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8</Font>
              <Guid>6d0251f7cc1e4d6eb6f4280206fa3d15</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text48</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Giấy tờ tài chính (bộ hồ sơ xe, hóa đơn tài chính)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Bottom</VertAlignment>
            </Text48>
            <Text49 Ref="58" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>4.2,2.4,3.3,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,8</Font>
              <Guid>af51dc5957d24f02a6f5b21dc8bb6db7</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text49</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Sổ bảo hành (dành cho xe và các phụ tùng, nếu có)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
