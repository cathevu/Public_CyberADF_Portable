            <Text85 Ref="261" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>4.2,2.8,3.2,0.4</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Arial,11</Font>
