            <HorizontalLinePrimitive1 Ref="48" type="HorizontalLinePrimitive" isKey="true">
              <ClientRectangle>0.2,1,7.5,0.01</ClientRectangle>
              <Color>Black</Color>
              <EndCap Ref="49" type="Cap" isKey="true">
