              <Margins>0,0,0,0</Margins>
              <Name>Text60</Name>
              <Page isRef="6" />
              <Parent isRef="9" />
              <Text>Cố vấn Dịch vụ đã giải thích các yêu cầu bảo dưỡng định kì</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
