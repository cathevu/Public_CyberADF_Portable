              <Name>Text102</Name>
              <Page isRef="228" />
              <Parent isRef="241" />
              <Text>ĐIỀU 3: THỜI GIAN, ĐỊA ĐIỂM VÀ PHƯƠNG THỨC GIAO HÀNG.</Text>
              <TextBrush>Black</TextBrush>
