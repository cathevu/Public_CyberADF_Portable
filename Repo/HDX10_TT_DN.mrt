              <ClientRectangle>6,148,174,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>fe956d61559648e3bc1d729d23cd11d6</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text61</Name>
              <Page isRef="228" />
              <Parent isRef="241" />
              <Text>Bên Mua có trách nhiệm thanh toán cho Bên Bán đầy đủ, đúng hạn như quy định trong Điều 2.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
