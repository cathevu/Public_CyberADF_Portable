              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text103</Name>
              <Page isRef="228" />
              <Parent isRef="241" />
              <Text>- Thời gian giao hàng dự kiến được thực hiện vào ngày: {Table0.Thang_Gx}, sau khi Bên Bán nhận 100% giá trị hợp đồng.
</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text103>
