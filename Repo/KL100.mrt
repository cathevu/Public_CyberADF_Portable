              <Margins>0,0,0,0</Margins>
              <Name>Text32</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Tiến hành lập biên bản vụ việc sau đây: (ghi thời gian, địa điểm xảy ra, phát hiện vụ việc, nội dung diễn biến, hiện trường, nguyên nhân, người chứng kiến, người liên quan, hậu quả tác hại, các biện pháp đã xử lý, kết quả đã xử lý kèm theo biên bản thu giữ tang chứng, vật chứng nếu có):</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text32>
